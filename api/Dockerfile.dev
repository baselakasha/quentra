FROM node:24-alpine

# yarn 1.x triggers Node's url.parse() deprecation warning; silence only that one
ENV NODE_OPTIONS=--disable-warning=DEP0169

WORKDIR /app

# Install dependencies
COPY package.json yarn.lock ./
RUN yarn install

# Copy source code
COPY . .

# Expose API port
EXPOSE 3000

# Development mode with hot reload
CMD ["yarn", "dev"]
